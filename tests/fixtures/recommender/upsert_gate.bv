import "../../../examples/recommender/store.bv";
import "std/env.bv";

defn upsert_gate_contents(conn: PgConn) -> Bool {
    let rows: PgResult = pg_simple_query(conn, "SELECT account_id,item_id,rating,ts FROM ratings ORDER BY account_id,item_id");
    term rows.ok && rows.nrows == 3 && rows.ncols == 4 &&
        pg_row_int(rows,0,0) == 1 && pg_row_int(rows,0,1) == 0 && pg_row_int(rows,0,2) == 5 && pg_row_int(rows,0,3) == 999 &&
        pg_row_int(rows,1,0) == 1 && pg_row_int(rows,1,1) == 1681 && pg_row_int(rows,1,2) == 3 && pg_row_int(rows,1,3) == 30 &&
        pg_row_int(rows,2,0) == 2 && pg_row_int(rows,2,1) == 0 && pg_row_int(rows,2,2) == 2 && pg_row_int(rows,2,3) == 20;
};

defn upsert_gate_run(conn: PgConn) -> Bool {
    let setup: PgResult = pg_simple_query(conn,
        "CREATE SCHEMA IF NOT EXISTS briev_upsert_gate; SET search_path TO briev_upsert_gate");
    when setup.ok == false { term false; };
    let schema: PgResult = store_create_schema(conn);
    when schema.ok == false { term false; };
    let reset: PgResult = pg_simple_query(conn,
        "DELETE FROM ratings; DELETE FROM accounts; INSERT INTO accounts(id,username,password) VALUES (1,'first','test'),(2,'second','test')");
    when reset.ok == false { term false; };
    let first: PgResult = store_rating_upsert(conn,1,0,1,10);
    let second: PgResult = store_rating_upsert(conn,2,0,2,20);
    let other_item: PgResult = store_rating_upsert(conn,1,1681,3,30);
    let replaced: PgResult = store_rating_upsert(conn,1,0,5,999);
    let scoped: Bool = first.ok && second.ok && other_item.ok && replaced.ok && upsert_gate_contents(conn);
    println!("replacement_and_account_item_isolation={}",scoped);
    let missing: PgResult = store_rating_upsert(conn,3,0,4,40);
    let fk_ok: Bool = missing.ok == false && missing.err_code == "23503";
    println!("missing_account_rejected={} code={}",fk_ok,missing.err_code);
    let a: PgResult = store_rating_upsert(conn,0,0,1,0);
    let b: PgResult = store_rating_upsert(conn,2147483648,0,1,0);
    let c: PgResult = store_rating_upsert(conn,1,-1,1,0);
    let d: PgResult = store_rating_upsert(conn,1,1682,1,0);
    let e: PgResult = store_rating_upsert(conn,1,0,0,0);
    let f: PgResult = store_rating_upsert(conn,1,0,6,0);
    let g: PgResult = store_rating_upsert(conn,1,0,1,-1);
    let bounds: Bool = !a.ok && !b.ok && !c.ok && !d.ok && !e.ok && !f.ok && !g.ok && upsert_gate_contents(conn);
    println!("invalid_inputs_preserve_rows={}",bounds);
    let begun: PgResult = pg_simple_query(conn,"BEGIN");
    let changed: PgResult = store_rating_upsert(conn,1,0,4,500);
    let rollback: PgResult = pg_simple_query(conn,"ROLLBACK");
    let owned: Bool = begun.ok && changed.ok && rollback.ok && upsert_gate_contents(conn);
    println!("caller_transaction_ownership={}",owned);
    let lowest: PgResult = store_rating_upsert(conn,2,1681,1,0);
    let low_row: PgResult = pg_simple_query(conn,"SELECT rating,ts FROM ratings WHERE account_id=2 AND item_id=1681");
    let highest: PgResult = store_rating_upsert(conn,2,1681,5,9223372036854775807);
    let high_row: PgResult = pg_simple_query(conn,"SELECT rating,ts FROM ratings WHERE account_id=2 AND item_id=1681");
    let endpoints: Bool = lowest.ok && low_row.ok && low_row.nrows == 1 && pg_row_int(low_row,0,0) == 1 && pg_row_int(low_row,0,1) == 0 &&
        highest.ok && high_row.ok && high_row.nrows == 1 && pg_row_int(high_row,0,0) == 5 && pg_row_text(high_row,0,1) == "9223372036854775807";
    println!("rating_and_timestamp_endpoints={}",endpoints);
    term scoped && fk_ok && bounds && owned && endpoints;
};
let tick: Int = 0;
node run [tick < 1][tick == 1] {
    let conn: PgConn = pg_connect(2130706433,5432,get_env("PGUSER"),get_env("PGDATABASE"),"");
    when conn.sock.fd < 0 || conn.pid < 0 { endprogram 1; };
    let passed: Bool = upsert_gate_run(conn);
    pg_close(conn);
    when passed == false { endprogram 1; };
    tick = 1;
    endprogram;
};