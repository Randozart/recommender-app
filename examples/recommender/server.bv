import "./server_loop.bv";
import "./bootstrap.bv";
import "./operation_store.bv";
import "std/env.bv";

defn server_env_number(key: String, fallback: Int) -> Int {
    let value: String = get_env(key);
    when value .^Length == 0 { term fallback; };
    term io_decimal(value);
};

defn server_fatal(message: String) -> Bool {
    println!("{}",message);
    stdout_flush();
    let exited: Int = syscall(60,1);
    term false;
};

defn server_boot() -> ServerState {
    let port: Int = server_env_number("PORT",8080);
    let capacity: Int = server_env_number("MAX_CONNECTIONS",1024);
    let lambda_milli: Int = server_env_number("LAMBDA_MILLI",500);
    let refresh_seconds: Int = server_env_number("REFRESH_SECONDS",300);
    when port < 1 || port > 65535 || capacity < 1 || capacity > 65535 || lambda_milli < 0 || lambda_milli > 1000 || refresh_seconds < 1 {
        server_fatal("Set PORT to 1..65535, MAX_CONNECTIONS to 1..65535, LAMBDA_MILLI to 0..1000 and REFRESH_SECONDS to a positive integer.");
    };
    let conn: PgConn = pg_connect(LOOPBACK,5432,get_env("PGUSER"),get_env("PGDATABASE"),"");
    when conn.pid < 0 || conn.sock.fd < 0 { server_fatal("Cannot connect to PostgreSQL on 127.0.0.1:5432; check PGUSER, PGDATABASE and local trust authentication."); };
    let schema: PgResult = store_create_schema(conn);
    when !schema.ok { pg_close(conn); server_fatal("Cannot create the database schema: "+schema.err_msg); };
    let receipt_schema: PgResult = pg_simple_query(conn,operation_store_table_ddl());
    when !receipt_schema.ok { pg_close(conn); server_fatal("Cannot create durable rating receipts: "+receipt_schema.err_msg); };
    let path: String = get_env("UDATA_PATH");
    when path .^Length == 0 { path = "u.data"; };
    let loaded: BaselineLoad = baseline_bootstrap(conn,path);
    when !loaded.ok { pg_close(conn); server_fatal(loaded.err_msg); };
    let catalogue_path: String = get_env("UITEM_PATH");
    when catalogue_path .^Length == 0 { catalogue_path = "u.item"; };
    let catalogue: MovieCatalogue = catalogue_load(catalogue_path,1682);
    when !catalogue.ok {
        pg_close(conn);
        server_fatal(catalogue.error+" The title catalogue must contain every MovieLens item in ID order.");
    };
    let model: Result<ServerModel,PgResult> = model_load(conn,943,1682);
    when is_err(model) { pg_close(conn); server_fatal("Cannot build the recommendation snapshot: "+unwrap_err(model).err_msg); };
    let reactor: Reactor = reactor_open(port,capacity);
    when reactor.listener < 0 {
        model_free(unwrap(model)); pg_close(conn);
        server_fatal("Cannot open the listener (errno "+reactor.listener as String+"); choose an available PORT and check descriptor limits.");
    };
    let initial: ServerState = server_new(reactor,conn,unwrap(model),catalogue,
        (lambda_milli as Float)/1000.0,refresh_seconds*1000);
    let workers: Result<ServerState,String> = server_workers_start(initial);
    when is_err(workers) { model_free(unwrap(model)); pg_close(conn); reactor_close(reactor);
        server_fatal("Cannot start the bounded persistence and prediction workers: "+unwrap_err(workers)); };
    let server: ServerState = unwrap(workers);
    when server.server_epoch .^Length != 32 {
        server_fatal("Cannot create a secure server session epoch; check system entropy availability.");
    };
    println!("Recommender listening on port {} with {} connection slots",port,capacity);
    stdout_flush();
    term server;
};

// 2026-10-23: the reactor carries worker/session state across firings whose
// external effects arrive later; keep that state live between socket events.
// Undo when reactive-node state is a first-class liveness root automatically.
out let server: ServerState = server_boot();
// 2026-10-21: this is an intentional long-lived service: socket readiness,
// not a finite iteration count, drives progress. One bounded sweep per firing.
// Replace the perpetual goal only when a graceful shutdown input is introduced.
out node serve [true][false] {
    server = server_step(server,100);
    term;
};

when true { reside; };
