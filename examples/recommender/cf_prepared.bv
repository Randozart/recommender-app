import { Means, SimCache, PopSignature, overlap_acc, lookup_row, pcc_finish,
    sim_next_item, sim_advance } from "./cf_engine.bv";
import "std/rating_population.bv";
import "std/matrix.bv";

// 2026-10-21: memoize the two stages of the existing equations, never widen
// the final pair's observed union. Row/column orientation is data, not separate
// algorithms. Retire only when general memoization derives the same reuse.
obj PreparedRows { off: IntVec; key: IntVec; value: Vector; mean: Vector; count: Int; width: Int; };
obj PreparedSpace { rows: PreparedRows; columns: PreparedRows; base: Matrix; filled: Matrix; };

defn prepared_base(rows: PreparedRows) -> Matrix {
    let base: Matrix = mat_new(rows.count,rows.count);
    foreach a in 0..rows.count {
        foreach b in 0..(a+1) {
            let (num,da,db): (Float,Float,Float) = overlap_acc(
                rows.key,rows.value,rows.key,rows.value,vec_get(rows.mean,a),vec_get(rows.mean,b),
                ivec_get(rows.off,a),ivec_get(rows.off,a+1),ivec_get(rows.off,b),ivec_get(rows.off,b+1),0.0,0.0,0.0);
            let value: Float = pcc_finish(num,da,db);
            mat_set(base,a,b,value); mat_set(base,b,a,value);
        };
    };
    term base;
};

defn prepared_cell(space: PreparedSpace, row: Int, col: Int) -> Float {
    let observed: Float = lookup_row(space.rows.key,space.rows.value,col,
        ivec_get(space.rows.off,row),ivec_get(space.rows.off,row+1));
    when observed >= 0.0 { term observed; };
    let accum: Float = 0.0;
    let weight: Float = 0.0;
    foreach idx in ivec_get(space.columns.off,col)..ivec_get(space.columns.off,col+1) {
        let neighbor: Int = ivec_get(space.columns.key,idx);
        when neighbor != row {
            let sim: Float = mat_get(space.base,row,neighbor);
            accum = accum + sim*(vec_get(space.columns.value,idx)-vec_get(space.rows.mean,neighbor));
            weight = weight + Fabs#(sim);
        };
    };
    let mean: Float = vec_get(space.rows.mean,row);
    when weight <= 0.0 { term mean; };
    term mean + accum/weight;
};

defn prepared_space(rows: PreparedRows, columns: PreparedRows) -> PreparedSpace {
    let space: PreparedSpace = PreparedSpace { rows: rows, columns: columns,
        base: prepared_base(rows), filled: mat_new(rows.count,rows.width) };
    foreach row in 0..rows.count {
        foreach col in 0..rows.width { mat_set(space.filled,row,col,prepared_cell(space,row,col)); };
    };
    term space;
};

defn prepared_pair(space: PreparedSpace, a: Int, b: Int) -> Float {
    let ia: Int = ivec_get(space.rows.off,a);
    let ib: Int = ivec_get(space.rows.off,b);
    let enda: Int = ivec_get(space.rows.off,a+1);
    let endb: Int = ivec_get(space.rows.off,b+1);
    let num: Float = 0.0; let da: Float = 0.0; let db: Float = 0.0;
    let ma: Float = vec_get(space.rows.mean,a);
    let mb: Float = vec_get(space.rows.mean,b);
    let limit: Int = enda+endb-ia-ib;
    foreach step in 0..limit {
        when ia >= enda && ib >= endb { term pcc_finish(num,da,db); };
        let key: Int = sim_next_item(space.rows.key,ia,enda,space.rows.key,ib,endb);
        let va: Float = mat_get(space.filled,a,key)-ma;
        let vb: Float = mat_get(space.filled,b,key)-mb;
        num = num+va*vb; da = da+va*va; db = db+vb*vb;
        let (na,nb): (Int,Int) = sim_advance(space.rows.key,ia,enda,space.rows.key,ib,endb,key);
        ia = na; ib = nb;
    };
    term pcc_finish(num,da,db);
};

defn prepared_matrix(rows: PreparedRows, columns: PreparedRows) -> Matrix {
    let space: PreparedSpace = prepared_space(rows,columns);
    let matrix: Matrix = mat_new(rows.count,rows.count);
    foreach a in 0..rows.count {
        foreach b in 0..(a+1) {
            let sim: Float = prepared_pair(space,a,b);
            mat_set(matrix,a,b,sim); mat_set(matrix,b,a,sim);
        };
    };
    mat_free(space.base); mat_free(space.filled);
    term matrix;
};

defn simcache_build_prepared(pop: RatingPopulation, means: Means, revision: Int) -> SimCache {
    let users: PreparedRows = PreparedRows { off: pop.user_off, key: pop.user_item,
        value: pop.user_val, mean: means.user_mean, count: pop.nusers, width: pop.nitems };
    let items: PreparedRows = PreparedRows { off: pop.item_off, key: pop.item_user,
        value: pop.item_val, mean: means.item_mean, count: pop.nitems, width: pop.nusers };
    term SimCache { user_sim: prepared_matrix(users,items), item_sim: prepared_matrix(items,users),
        user_mean: means.user_mean, item_mean: means.item_mean, nusers: pop.nusers,
        nitems: pop.nitems, sig: PopSignature { nnz: pop.nnz, mtime: revision } };
};
