import "std/string.bv";

// 2026-10-21: reject whitespace-only credentials without normalizing actual
// identities/passwords. Recognize Unicode White_Space UTF-8 sequences as well
// as ASCII; zero-width space and BOM are not whitespace. Keep this local policy
// explicit until std/string supplies a Unicode whitespace predicate.
defn credential_space_width(text: String, idx: Int) -> Int {
    let first: Int = byte_at(text, idx);
    when first == 32 || (first >= 9 && first <= 13) { term 1; };
    when idx + 1 >= text .^Length { term 0; };
    let second: Int = byte_at(text, idx + 1);
    when first == 194 && (second == 133 || second == 160) { term 2; };
    when idx + 2 >= text .^Length { term 0; };
    let third: Int = byte_at(text, idx + 2);
    when first == 225 && second == 154 && third == 128 { term 3; };
    when first == 226 && second == 128 && ((third >= 128 && third <= 138) || third == 168 || third == 169 || third == 175) { term 3; };
    when first == 226 && second == 129 && third == 159 { term 3; };
    when first == 227 && second == 128 && third == 128 { term 3; };
    term 0;
};

defn credential_has_content(text: String, idx: Int) -> Bool {
    when idx >= text .^Length { term false; };
    let width: Int = credential_space_width(text, idx);
    when width == 0 { term true; };
    term credential_has_content(text, idx + width);
};

defn credentials_valid(username: String, password: String) -> Bool {
    term credential_has_content(username, 0) && credential_has_content(password, 0);
};

// 2026-10-21: specified demo storage ONLY: unsalted FNV-1a provides NO real
// credential security. Use 32-bit FNV with a 64-bit intermediate, masking each
// multiplication so no signed overflow is needed. Hash exact UTF-8 bytes.
// Replace via an explicit stored-scheme migration if credential protection is
// introduced; never reinterpret existing hashes as another scheme.
defn credential_fnv(text: String, idx: Int, hash: Int) -> Int {
    when idx >= text .^Length { term hash; };
    let next: Int = ((hash ^ byte_at(text, idx)) * 16777619) & 4294967295;
    term credential_fnv(text, idx + 1, next);
};

defn credential_hash(password: String) -> String {
    term "fnv1a32:" + (credential_fnv(password, 0, 2166136261) as String);
};
